# Copy to BE/.env; keep credentials outside Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/workflow_dev?replicaSet=rs0
WEB_ORIGIN=http://localhost:5173
# Generate two distinct cryptographically random 32-byte keys as lowercase hex in your local .env.
# Empty values intentionally prevent startup; never commit real keys.
JWT_ACCESS_KEY_HEX=
JWT_REFRESH_KEY_HEX=
MAIL_OUTBOX_KEY_HEX=
TERMS_VERSION=draft-2026-10-03
# Google ID verification is disabled until a real OAuth Web client ID is configured.
GOOGLE_CLIENT_ID=
# disabled keeps jobs queued; capture writes previews under ignored .local/mail; smtp requires TLS.
EMAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
